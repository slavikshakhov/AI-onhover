{
  "name": "hover-ask-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "cross-env DEMO_MODE=1 node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "node scripts/start.mjs",
    "start:demo": "cross-env DEMO_MODE=1 node scripts/start.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "format": "prettier --write src electron tests scripts",
    "test:code-ui": "node scripts/code-flow.mjs",
    "test:screenshot-ui": "node scripts/screenshot-flow.mjs",
    "test:dev-ui": "node scripts/dev-lifecycle.mjs",
    "test:screenshot-outputs-ui": "node scripts/screenshot-output-flow.mjs",
    "test:fit-ui": "node scripts/panel-fit-flow.mjs",
    "test:session-ui": "node scripts/session-flow.mjs",
    "test:startup-ui": "node scripts/startup-flow.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
